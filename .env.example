# Supabase → Project Settings → API (və ya Connect) bölməsindən götürün.
# Yalnız "anon / publishable" açarı istifadə olunur. service_role açarını HEÇ VAXT bura yazmayın.
VITE_SUPABASE_URL=https://XXXXXXXXXXXX.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google ilə giriş düyməsini göstərmək üçün (əvvəlcə Supabase-də Google provider-i aktiv edin)
VITE_ENABLE_GOOGLE_LOGIN=false
